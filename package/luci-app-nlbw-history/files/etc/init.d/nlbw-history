#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/nlbw-history-loop

start_service() {
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile /var/run/nlbw-history.pid
	procd_close_instance
}

stop_service() {
	# Don't lose the samples still buffered in RAM.
	/usr/bin/nlbw-history-collect --flush >/dev/null 2>&1
}

service_triggers() {
	procd_add_reload_trigger "nlbw-history"
}

reload_service() {
	restart
}

status_service() {
	/usr/bin/nlbw-history-collect --status
}
