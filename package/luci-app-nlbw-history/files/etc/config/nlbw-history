config nlbw_history 'main'
	# Seconds between samples. Lower gives sharper graphs and more data.
	option period '60'
	# Days of history to keep.
	option retention '30'
	# Samples are buffered in RAM and written to data_dir this often, so the
	# router is not writing to storage every single interval.
	option flush_interval '600'
	# Must be persistent storage. /tmp and /var are RAM on OpenWrt and would
	# lose the whole history on every reboot.
	option data_dir '/srv/nlbw-history'
	# Also record which protocol each device was using.
	option protocols '1'
	# Protocol traffic is aggregated into buckets this many seconds wide,
	# because the protocol dimension multiplies the number of rows stored.
	option protocol_interval '900'
	# Ceiling for one sample, in Mbit/s. A sample claiming more than this link
	# could have carried since the previous one is recorded as discarded
	# instead of charted: a flow offload counter glitch can fold a bogus
	# terabyte into conntrack in one go, and nlbwmon reports that as real
	# traffic. Set it to the fastest link a device here can use. 0 accepts
	# every sample.
	option max_rate '10000'
	# Display only. auto follows the browser's locale; 24 or 12 force the
	# clock, dmy prints 31/12 and mdy prints 12/31.
	option time_format 'auto'
	option date_format 'auto'
