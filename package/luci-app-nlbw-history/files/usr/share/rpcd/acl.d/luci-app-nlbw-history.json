{
	"luci-app-nlbw-history": {
		"description": "Read historical per-device bandwidth data and manage its settings",
		"read": {
			"ubus": {
				"luci_nlbw_history": [ "series", "status", "live" ]
			},
			"uci": [ "nlbw-history" ]
		},
		"write": {
			"ubus": {
				"luci_nlbw_history": [ "scrub" ]
			},
			"uci": [ "nlbw-history" ]
		}
	}
}
